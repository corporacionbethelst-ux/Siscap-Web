# ============================================================
# SISCAP Web v6.0 — Backend | Variables de entorno (plantilla)
# Copie este archivo como .env y complete los valores reales.
# NUNCA suba el archivo .env al repositorio.
# ============================================================

# --- Base de datos (PostgreSQL) ---
DATABASE_URL=postgresql://siscap_user:CAMBIA_ESTO_POR_PASSWORD_REAL@localhost:5432/siscap_db

# --- Seguridad JWT ---
# Genere uno con: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=REEMPLAZAR_CON_CLAVE_ALEATORIA_DE_64_BYTES
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Importación de archivos ---
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=10

# --- Entorno ---
ENVIRONMENT=development
