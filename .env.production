# ============================================================
# SISCAP Web — Plantilla de producción (docker-compose.production.yml)
# ⚠️ Este archivo NO debe contener secretos reales versionados.
# Copie a .env.production.local (ignorado por git) y complete.
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=siscap_user
POSTGRES_PASSWORD=__REEMPLAZAR_CON_PASSWORD_SEGURO__
POSTGRES_DB=siscap_db

# --- Backend (leído por app.core.config.Settings vía env_file) ---
DATABASE_URL=postgresql://siscap_user:__REEMPLAZAR_CON_PASSWORD_SEGURO__@db:5432/siscap_db
SECRET_KEY=__REEMPLAZAR_CON_python_-c_"import_secrets;_print(secrets.token_urlsafe(64))"__
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
APP_NAME=SISCAP Web
APP_VERSION=6.0.0
DEBUG=false
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=10
